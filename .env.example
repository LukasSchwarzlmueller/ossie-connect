# Copy to .env in the folder you run ossie-connect from. .env is gitignored.
# Leave out any platform you do not use. Variables already set in the shell win.

# Fabric - auth is the Azure CLI (`az login`), or set FABRIC_TOKEN
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
# Only if the lakehouse is in another workspace
FABRIC_LAKEHOUSE_WORKSPACE_ID=
FABRIC_SCHEMA=dbo
# Optional - workspace folder new models are created in
FABRIC_FOLDER_ID=
FABRIC_TOKEN=

# Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
# Needed to upload, not to download
DATABRICKS_WAREHOUSE_ID=
# Optional - your own Java converter jar, instead of the one
# `ossie-connect build-databricks-converter` builds
OSSIE_DATABRICKS_JAR=

# Snowflake (needs the [snowflake] extra)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Optional - falls back to your default role
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional - default OSSIE_COMPUTE_WH, created if missing
SNOWFLAKE_WAREHOUSE=
